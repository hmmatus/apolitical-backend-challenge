---
// Static output has no server-side redirect (no Astro.redirect() without SSR), so this is a
// client-side bounce. /orders' own guard decides from there whether the visitor lands on the
// order list or gets sent on to /login.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/orders" />
    <title>Pizza App</title>
  </head>
  <body>
    <script is:inline>
      location.replace("/orders");
    </script>
    <p>Redirecting…</p>
  </body>
</html>
