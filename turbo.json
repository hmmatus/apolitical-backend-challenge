{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "build": { "dependsOn": ["^build"], "outputs": [] },
    "typecheck": { "dependsOn": ["transit"], "outputs": [] },
    "test": { "dependsOn": ["transit"], "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
